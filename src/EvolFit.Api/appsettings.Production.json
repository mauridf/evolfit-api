    },
    "Wger": {
      "BaseUrl": "https://wger.de/api/v2/",
      "CacheTtlDays": 7,
      "TimeOutSeconds": 30,
      "Language": 2
    }
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
