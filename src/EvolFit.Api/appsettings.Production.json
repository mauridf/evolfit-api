{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "EvolFit",
    "Audience": "evolfit-api",
    "ExpireMinutes": 120,
    "RefreshTokenExpireDays": 7
  },
  "ExternalApis": {
